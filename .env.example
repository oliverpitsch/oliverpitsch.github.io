# Public env vars for PostHog (safe to expose)
# Copy this file to `.env.local` and fill in your values.

NEXT_PUBLIC_POSTHOG_KEY=phc_your_public_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Personalized application CVs (server-only)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@pooled-host/database?sslmode=require
ADMIN_PASSWORD=choose-a-long-unique-password
AUTH_SECRET=generate-at-least-32-random-bytes
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-5-mini
